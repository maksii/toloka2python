{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug toloka2python (live)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_live.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "TOLOKA_USER": "your_username",
        "TOLOKA_PASSWORD": "your_password"
      }
    }
  ]
}
